    <string name="mode_classic_title">Classic Mode</string>
    <string name="mode_classic_description">Test your reflexes.</string>
    <string name="mode_classic_long_description">The purest way to test your reflexes. A target appears on the screen and you must tap it before time runs out. Every correct tap increases your score, while the pace gets faster as you progress.</string>
    <string name="mode_moving_title">Moving Target</string>
    <string name="mode_moving_description">The target moves and gets faster over time.</string>
    <string name="mode_moving_long_description">The target no longer stays still. Catch the moving target, tap at the right moment, and keep up with the increasing speed. This mode challenges your eyes, hands, and reflexes together.</string>
    <string name="mode_fake_title">Fake Target</string>
    <string name="mode_fake_description">Don’t tap the wrong target.</string>
    <string name="mode_fake_long_description">Not every target you see is the correct one. Find the real target and avoid the fake ones. A wrong tap can end the game. This mode tests both your focus and reaction speed.</string>
    <string name="mode_color_title">Color Reflex</string>
    <string name="mode_color_description">Tap only the correct color.</string>
    <string name="mode_color_long_description">Different colors appear on the screen, but you must tap only the requested color. Follow the active color task and avoid wrong taps. Fast decision-making is the key.</string>
