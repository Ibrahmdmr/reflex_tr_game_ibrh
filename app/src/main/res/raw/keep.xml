<?xml version="1.0" encoding="utf-8"?>
<!--
  GameSoundController loads its effects by name via Resources.getIdentifier("sfx_...", "raw", ...)
  so that sound files can be dropped in later without code changes. Resource shrinking sees no
  static R.raw reference and would strip them from release builds, leaving the game silently
  falling back to generated tones. This keep rule preserves them.
-->
<resources xmlns:tools="http://schemas.android.com/tools"
    tools:keep="@raw/sfx_*" />
