    <string name="mode_classic_description">Refleksini test et.</string>
    <string name="mode_classic_long_description">Reflekslerini test etmenin en saf hali. Hedef ekrana gelir, sen zaman dolmadan dokunursun. Her doğru dokunuş skorunu artırır, oyun ilerledikçe süre daralır ve tempo yükselir.</string>
